@using System.Globalization
@inject IPlanCatalogService Catalog
@inject IGameCatalogService Games
@inject IStringLocalizer<StorefrontText> Text
@inject StorefrontCurrencyService Currencies

<section class="teaser" id="plans" aria-labelledby="teaser-heading">
    <div class="hts-container hts-container--wide">
        <div class="teaser-head">
            <div><p class="storefront-kicker"><span>02</span>@Text["Plans.Kicker"]</p><h2 id="teaser-heading" class="storefront-title"><MaskReveal>@Text["Plans.Title"]</MaskReveal></h2></div>
            <p class="storefront-copy" data-reveal>@Text["Plans.Copy"]</p>
        </div>
        <div class="preview-plans">
            @foreach (var (plan, index) in PreviewPlans.Select((plan, index) => (plan, index)))
            {
                <article class="preview-plan @(plan.IsRecommended ? "is-recommended" : null)" data-reveal style="--hts-reveal-delay: @(index * 70)ms">
                    <div class="plan-top"><h3>@plan.Name</h3>@if (plan.IsRecommended) { <span class="plan-badge">@Text["Plans.Recommended"]</span> }</div>
                    <p class="plan-memory"><strong>@plan.MemoryGb</strong><span>GB @Text["Plans.Memory"]</span></p>
                    <dl class="plan-specs">
                        <div><dt>@Text["Plans.Cpu"]</dt><dd>@plan.CpuPercent%</dd></div>
                        <div><dt>@Text["Plans.Storage"]</dt><dd>@plan.DiskGb GB</dd></div>
                        <div><dt>@Text["Plans.Backups"]</dt><dd>@plan.BackupLimit</dd></div>
                    </dl>
                    <div class="plan-price">
                        @if (Catalog.Quote(plan, BillingPeriod.Monthly) is { } quote)
                        {
                            <span>@Text["Plans.From"]</span>
                            <p><strong>@Currencies.FormatCatalogAmount(quote.FinalAmount, Currency)</strong><span>@Text["Plans.PerMonth"]</span></p>
                            <CtaButton Href="@SiteRoutes.Review(Games.Primary.Slug, plan.Slug, BillingPeriod.Monthly, Currency)" Variant="@(plan.IsRecommended ? CtaVariant.Primary : CtaVariant.Secondary)" TrailingIcon="IconName.ArrowRight">@Text["Plans.View"]</CtaButton>
                        }
                        else
                        {
                            <p class="pending">@Text["Plans.Pending"]</p>
                            <CtaButton Href="@Games.Primary.PageHref" Variant="CtaVariant.Secondary" TrailingIcon="IconName.ArrowRight">@Text["Plans.View"]</CtaButton>
                        }
                    </div>
                </article>
            }
        </div>
        <div class="teaser-foot"><span>@Games.Primary.Name</span><a class="hts-text-link" href="@SiteRoutes.ProjectZomboidPlans">@Text["Plans.All"] <Icon Name="IconName.ArrowRight" /></a></div>
    </div>
</section>

@code {
    [CascadingParameter(Name = "StorefrontCurrency")]
    public string Currency { get; set; } = "usd";

    private IReadOnlyList<HostingPlan> PreviewPlans
    {
        get
        {
            var plans = Games.PlansFor(Games.Primary);
            if (plans.Count == 0) return [];
            return new[] { plans[0], plans.FirstOrDefault(p => p.IsRecommended) ?? plans[plans.Count / 2], plans[^1] }.DistinctBy(p => p.Slug).ToArray();
        }
    }
}

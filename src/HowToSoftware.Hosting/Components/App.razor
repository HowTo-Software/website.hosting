@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1016" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <base href="/" />

    @* Applies the saved theme before first paint. A Blazor component cannot run
       early enough to prevent a flash of the wrong theme, so this one stays inline. *@
    <script nonce="@CspNonce">
        (function () {
            document.documentElement.classList.add("hts-script");
            try {
                var t = localStorage.getItem("hts-theme");
                if (t === "light" || t === "dark") {
                    document.documentElement.setAttribute("data-theme", t);
                }
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />

    @*
        The two faces the page is set in, fetched before the stylesheet that asks for them.
        Only the latin subsets are preloaded: latin-ext exists for the handful of characters
        outside Latin-1 and is not worth a blocking request on a page that may never use one.
    *@
    <link rel="preload" as="font" type="font/woff2" href="@Assets["fonts/archivo-latin.woff2"]" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="@Assets["fonts/jetbrains-mono-latin.woff2"]" crossorigin />

    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["HowToSoftware.Hosting.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/storefront.css"]" />
    <link rel="stylesheet" href="@Assets["css/no-script.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet />
</head>

<body>
    <div class="hts-progress" data-navigation-progress aria-hidden="true"></div>
    <Routes />
    <script nonce="@CspNonce" src="@Assets["_framework/blazor.web.js"]"></script>
    <script nonce="@CspNonce" src="@Assets["js/site.js"]"></script>
    <script nonce="@CspNonce" src="@Assets["js/vector-wordmark.js"]"></script>
    <script nonce="@CspNonce" src="@Assets["js/customer-ui.js"]"></script>
</body>

</html>

@code {
    private string? CspNonce => SecurityHeadersMiddleware.GetNonce(HttpContextAccessor.HttpContext);
}


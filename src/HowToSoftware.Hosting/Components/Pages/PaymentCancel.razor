@*
    Where Stripe sends the customer if they back out of Checkout.

    The order is not deleted and nothing is charged. The configuration is shown again from the
    order record, priced again from the catalogue, and every way back is a link: the same plan
    and period, a different period, or the plans.
*@

@page "/payment/cancel"
@inject IPlanCatalogService Catalog
@inject IOrderPricingService Pricing
@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<CheckoutText> Text

<PageTitle>@Text["Cancel.MetaTitle"] | @Site.Value.Name</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section class="cancel" aria-labelledby="cancel-heading">
    <div class="hts-container hts-container--wide cancel-inner">
        <div class="cancel-copy" data-reveal>
            <p class="cancel-kicker">
                <span class="kicker-index">—</span>
                <span class="hts-label">@Text["Cancel.Kicker"]</span>
            </p>

            <h1 id="cancel-heading" class="cancel-title" data-text-effect="rise">@Text["Cancel.Title"]</h1>

            @if (_priced is { } priced)
            {
                <p class="cancel-lede">@Text["Cancel.Lede"]</p>

                <div class="cancel-actions">
                    <CtaButton Href="@SiteRoutes.Review(priced.Game.Slug, priced.Plan.Slug, priced.Quote.Period, priced.CurrencyCode)"
                               Variant="CtaVariant.Primary"
                               TrailingIcon="IconName.ArrowRight">
                        @Text["Cancel.TryAgain"]
                    </CtaButton>
                    <CtaButton Href="@(priced.Game.PageHref is { } page ? page + "#plans" : SiteRoutes.GameHosting)"
                               Variant="CtaVariant.Secondary">
                        @Text["Cancel.Return"]
                    </CtaButton>
                </div>

                <div class="cancel-periods">
                    <p class="hts-label periods-label">@Text["Cancel.ChangePeriod"]</p>
                    <ul class="period-links">
                        @foreach (var other in Catalog.BillingOptions.Where(o => o.Period != priced.Quote.Period))
                        {
                            <li>
                                <a class="period-link" href="@SiteRoutes.Review(priced.Game.Slug, priced.Plan.Slug, other.Period, priced.CurrencyCode)">
                                    <span>@other.Label</span>
                                    @if (other.DiscountPercent > 0)
                                    {
                                        <span class="period-save hts-mono">-@other.DiscountPercent%</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p class="cancel-lede">@Text["Cancel.NotFound"]</p>

                <div class="cancel-actions">
                    <CtaButton Href="@SiteRoutes.ProjectZomboidPlans" Variant="CtaVariant.Primary" TrailingIcon="IconName.ArrowRight">
                        @Text["Review.BackToPlans"]
                    </CtaButton>
                </div>
            }
        </div>

        @if (_priced is { } summary)
        {
            <div class="cancel-panel" data-reveal="right">
                <OrderSummary Game="summary.Game"
                              Plan="summary.Plan"
                              Quote="summary.Quote"
                              PeriodLabel="@Catalog.GetOption(summary.Quote.Period).Label"
                              CurrencyCode="@summary.CurrencyCode"
                              ShowAudience="false" />
            </div>
        }
    </div>
</section>

@code {
    private PricedPlan? _priced;

    [CascadingParameter(Name = "StorefrontCurrency")]
    public string BrowserCurrency { get; set; } = "usd";

    [SupplyParameterFromQuery(Name = "currency")]
    public string? CurrencyQuery { get; set; }

    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    [SupplyParameterFromQuery(Name = "plan")]
    public string? PlanQuery { get; set; }

    [SupplyParameterFromQuery(Name = "period")]
    public string? PeriodQuery { get; set; }

    protected override void OnParametersSet()
    {
        var period = BillingPolicy.TryParse(PeriodQuery, out var parsed)
            ? parsed
            : BillingPeriod.Monthly;

        // These values select public catalogue entries only. The server recalculates the quote;
        // no amount or internal order identifier arrives from the browser.
        _priced = Pricing.Price(GameQuery, PlanQuery, period, CurrencyQuery ?? BrowserCurrency);
    }
}


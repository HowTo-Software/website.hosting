@*
    Choose the game before configuring the server. The available product leads the storefront;
    roadmap games and requests remain secondary. Every displayed price comes from the catalogue.
*@

@page "/game-hosting"
@using System.Globalization
@inject IGameCatalogService Games
@inject IPlanCatalogService Catalog
@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<CheckoutText> Text
@inject StorefrontCurrencyService Currencies

<PageTitle>@Text["GameHosting.MetaTitle"] | @Site.Value.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["GameHosting.MetaDescription"]" />
    <link rel="canonical" href="@($"{Site.Value.BaseUrl.TrimEnd('/')}{SiteRoutes.GameHosting}")" />
</HeadContent>

<section class="catalog" aria-labelledby="catalog-heading" data-motion="scene" data-scene>
    <div class="hts-container hts-container--wide">
        <div class="catalog-intro">
            <header class="catalog-head" data-reveal>
                <p class="catalog-kicker" data-motion-step="label">
                    <span class="kicker-index">01</span>
                    <span class="hts-label">@Text["GameHosting.Kicker"]</span>
                </p>
                <h1 id="catalog-heading" class="catalog-title" data-text-effect="rise" data-motion-step="headline">@Text["GameHosting.Title"]</h1>
                <p class="catalog-lede" data-motion-step="copy">@Text["GameHosting.Lede"]</p>
            </header>

            <aside class="catalog-guide" data-reveal aria-labelledby="catalog-guide-heading">
                <p class="hts-label" id="catalog-guide-heading">@Text["GameHosting.HowKicker"]</p>
                <ol class="how">
                    <li><span class="how-index hts-mono">01</span><span>@Text["GameHosting.Step1"]</span></li>
                    <li><span class="how-index hts-mono">02</span><span>@Text["GameHosting.Step2"]</span></li>
                    <li><span class="how-index hts-mono">03</span><span>@Text["GameHosting.Step3"]</span></li>
                    <li><span class="how-index hts-mono">04</span><span>@Text["GameHosting.Step4"]</span></li>
                </ol>
            </aside>
        </div>

        <ul class="games" data-motion-stagger>
            @foreach (var (game, index) in Games.Games.Select((g, i) => (g, i)))
            {
                var isPrimary = string.Equals(game.Slug, Games.Primary.Slug, StringComparison.Ordinal);
                var plans = Games.PlansFor(game);
                var from = Games.StartingPrice(game);

                <li class="game @(isPrimary ? "is-primary" : null) @(game.IsAvailable ? "is-available" : "is-planned")"
                    data-reveal
                    data-motion-step="card"
                    style="--hts-reveal-delay: @(index * 90)ms">

                    <GameCover Game="game"
                               Tag="@(game.IsAvailable ? Text["GameHosting.CoverTagAvailable"] : Text["GameHosting.CoverTagPlanned"])"
                               CssClass="game-cover" />

                    <div class="game-body">
                        <p class="game-status hts-label">
                            @if (game.IsAvailable)
                            {
                                <span class="status-lamp" aria-hidden="true"></span>
                            }
                            @(isPrimary ? Text["GameHosting.Primary"] : game.IsAvailable ? Text["GameHosting.Available"] : Text["GameHosting.Planned"])
                        </p>

                        <h2 class="game-name">@game.Name</h2>
                        <p class="game-tagline">@game.Tagline</p>
                        <p class="game-summary">@game.Summary</p>

                        @if (game.Highlights.Count > 0)
                        {
                            <ul class="game-highlights">
                                @foreach (var highlight in game.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>
                        }

                        <div class="game-foot">
                            @if (game.IsAvailable)
                            {
                                <div class="game-price">
                                    @if (from is { } price)
                                    {
                                        <span class="price-from hts-label">@Text["GameHosting.From"]</span>
                                        <span class="price-figure">
                                            <span class="price-symbol hts-mono">@Currencies.Symbol(Currency)</span><span class="price-amount hts-mono">@Currencies.FormatCatalogNumber(price, Currency)</span>
                                            <span class="price-unit">@Text["GameHosting.PerMonth"]</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="price-pending hts-mono">@Text["GameHosting.Unpriced"]</span>
                                    }

                                    @if (plans.Count > 0)
                                    {
                                        <span class="price-range hts-mono">@Text["GameHosting.PlansCount", plans.Count, plans[0].MemoryGb, plans[^1].MemoryGb]</span>
                                    }
                                </div>

                                <CtaButton Href="@game.PageHref"
                                           Variant="CtaVariant.Primary"
                                           TrailingIcon="IconName.ArrowRight"
                                           CssClass="game-cta">
                                    @Text["GameHosting.ViewPlans"]
                                </CtaButton>
                            }
                            else
                            {
                                <CtaButton Href="@NotifyHref(game)"
                                           Variant="CtaVariant.Secondary"
                                           TrailingIcon="IconName.Mail"
                                           CssClass="game-cta">
                                    @Text["GameHosting.NotifyMe"]
                                </CtaButton>
                            }
                        </div>
                    </div>
                </li>
            }

            <li class="game game--request" data-reveal data-motion-step="card" style="--hts-reveal-delay: @(Games.Games.Count * 90)ms">
                <div class="request">
                    <p class="hts-label request-kicker">@Text["GameHosting.RequestKicker"]</p>
                    <h2 class="request-title">@Text["GameHosting.RequestTitle"]</h2>
                    <p class="request-body">@Text["GameHosting.RequestBody"]</p>
                    <CtaButton Href="@RequestHref"
                               Variant="CtaVariant.Secondary"
                               TrailingIcon="IconName.Mail">
                        @Text["GameHosting.RequestCta"]
                    </CtaButton>
                </div>
            </li>
        </ul>

    </div>
</section>

<TrialServerBanner />

@code {
    [CascadingParameter(Name = "StorefrontCurrency")]
    public string Currency { get; set; } = "usd";

    private string RequestHref =>
        $"mailto:{Site.Value.ContactEmail}?subject={Uri.EscapeDataString(Text["GameHosting.RequestSubject"].Value)}";

    private string NotifyHref(HostedGame game) =>
        $"mailto:{Site.Value.ContactEmail}?subject={Uri.EscapeDataString(Text["GameHosting.NotifySubject", game.Name].Value)}";
}


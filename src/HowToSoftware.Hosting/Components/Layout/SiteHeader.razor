@*
    Primary site navigation.

    Rendered as an interactive island so the mobile menu is real Blazor state rather than a
    CSS checkbox hack: the toggle is a proper <button> with aria-expanded/aria-controls, and
    selecting a link closes the panel.

    The site is no longer one page, so the header now also carries the route-level entries -
    Infrastructure and the control-panel sign-in - and marks whichever one you are on. Section
    anchors are absolute (`/#plans`) so they still work from those pages.
*@

@rendermode InteractiveServer
@implements IDisposable
@inject IMarketingContentService Content
@inject IStringLocalizer<CommonText> Text
@inject IStringLocalizer<CustomerText> CustomerText
@inject NavigationManager Navigation

<header class="site-header @(_isOpen ? "has-open-menu" : null)" @onkeydown="OnKeyDown">
    @if (_isOpen)
    {
        <div class="header-backdrop" aria-hidden="true" @onclick="Close"></div>
    }
    <div class="hts-container hts-container--wide header-inner">
        <a class="header-brand" href="/" aria-label="@Text["Brand.HomeLabel", SiteName]" @onclick="Close">
            <BrandMark Name="@SiteName" />
        </a>

        <div id="primary-navigation" class="header-panel @(_isOpen ? "is-open" : null)">
            <nav class="header-nav" aria-label="@Text["Nav.Primary"]">
                <ul>
                    @foreach (var link in HeaderLinks)
                    {
                        <li>
                            <a href="@link.Href"
                               class="@(IsCurrentPage(link.Href) ? "is-current" : null)"
                               aria-current="@(IsCurrentPage(link.Href) ? "page" : null)"
                               @onclick="Close"><RollingNavText Text="@link.Label" /></a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="header-actions">
                <a href="/account" class="header-customer" @onclick="Close">@CustomerText["Portal.Title"]</a>
                @* The customer's control panel is a separate application. Preserve its
                   absolute destination and secure new-tab behaviour. *@
                <CtaButton Href="@PanelUrl"
                           Variant="CtaVariant.Primary"
                           Size="CtaSize.Small"
                           Target="_blank"
                           Rel="noopener noreferrer"
                           TrailingIcon="IconName.ArrowRight"
                           title="@Text["Cta.SignIn"]"
                           OnClick="Close">
                    @Text["Product.ControlPanel"]
                </CtaButton>
            </div>
        </div>

        <div class="header-utility">
            <LanguageSwitcher />
            <ThemeToggle />
        </div>

        <button type="button"
                class="header-toggle"
                @ref="_menuToggle"
                aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
                aria-controls="primary-navigation"
                aria-label="@(_isOpen ? Text["Nav.CloseMenu"] : Text["Nav.OpenMenu"])"
                @onclick="Toggle">
            <Icon Name="@(_isOpen ? IconName.Close : IconName.Menu)" />
        </button>
    </div>
    <noscript>
        <nav class="header-static hts-container hts-container--wide" aria-label="@Text["Nav.Primary"]">
            @foreach (var link in HeaderLinks)
            {
                <a href="@link.Href">@link.Label</a>
            }
            <a href="@PanelUrl" target="_blank" rel="noopener noreferrer">@Text["Product.ControlPanel"]</a>
            <a href="/account">@CustomerText["Portal.Title"]</a>
        </nav>
    </noscript>
</header>

@code {
    /// <summary>
    /// Where the panel button goes.
    /// </summary>
    /// <remarks>
    /// The Pterodactyl panel, which is a different application on a different host. It is not a
    /// route in this site and must never be written as one - a relative href here would send
    /// somebody to a 404 on the marketing site instead of to their servers.
    /// </remarks>
    private const string PanelUrl = SiteRoutes.PanelLogin;

    private bool _isOpen;
    private ElementReference _menuToggle;

    private IReadOnlyList<NavigationLink> HeaderLinks =>
    [
        .. Content.PrimaryNavigation.Take(2),
        new(Text["Company.Contact"], "/#contact")
    ];

    /// <summary>Brand name shown in the header lockup.</summary>
    [Parameter]
    public string SiteName { get; set; } = "HowToSoftware";

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void Toggle() => _isOpen = !_isOpen;

    private void Close() => _isOpen = false;

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (_isOpen && args.Key == "Escape")
        {
            Close();
            await _menuToggle.FocusAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        // A route change repaints the current-page marker and dismisses the mobile panel.
        _isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Whether a link points at the page currently being viewed. Only route links can be
    /// "current": an in-page anchor describes a position, not a destination.
    /// </summary>
    private bool IsCurrentPage(string href)
    {
        if (href.Contains('#', StringComparison.Ordinal))
        {
            return false;
        }

        var current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var target = "/" + href.Trim('/');

        if (string.Equals(current, target, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // The infrastructure page answers to both of its routes; either one is "here".
        return target is "/infrastructure" && string.Equals(current, "/hardware", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}


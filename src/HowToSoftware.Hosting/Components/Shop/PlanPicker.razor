@*
    Billing and layout are native radios. CSS selects one catalogue quote per plan and reflows
    the same list into a comparison; both work without JavaScript. Review links carry only the
    game, plan, and period so the server prices the order again before payment.
*@

@using System.Globalization
@inject IPlanCatalogService Catalog
@inject IStringLocalizer<CheckoutText> Text
@inject StorefrontCurrencyService Currencies

<section class="picker" id="plans" aria-labelledby="picker-heading" data-motion="scene" data-scene>
    <div class="hts-container hts-container--wide">
        <header class="picker-head" data-reveal>
            <p class="picker-kicker" data-motion-step="label">
                <span class="kicker-index">@Index</span>
                <span class="hts-label">@Text["Picker.Kicker"]</span>
            </p>
            <h2 id="picker-heading" class="picker-title" data-motion-step="headline">@Text["Picker.Title"]</h2>
            @if (Smallest is { } small && Largest is { } large)
            {
                <p class="picker-lede" data-motion-step="copy">@Text["Picker.Lede", small.MemoryGb, large.MemoryGb, Plans.Count]</p>
            }
        </header>

        <div class="picker-tools" data-reveal>
            @if (Catalog.HasPricing)
            {
                <fieldset class="periods">
                    <legend class="periods-legend hts-label">@Text["Picker.PeriodLegend"]</legend>

                    <div class="periods-track">
                        @foreach (var option in Catalog.BillingOptions)
                        {
                            <input type="radio"
                                   class="period-input"
                                   name="period"
                                   id="period-@option.Slug"
                                   value="@option.Slug"
                                   checked="@(option.Period == BillingPeriod.Monthly)" />
                            <label class="period" for="period-@option.Slug">
                                <span class="period-name">@option.Label</span>
                                @if (option.DiscountPercent > 0)
                                {
                                    <span class="period-save hts-mono">@Text["Picker.Save", option.DiscountPercent]</span>
                                }
                            </label>
                        }
                    </div>
                    <p class="periods-help">@Text["Picker.TotalNote"]</p>
                </fieldset>
            }

            <fieldset class="view-switch">
                <legend class="hts-label">@Text["Picker.ViewLegend"]</legend>
                <div class="view-track">
                    <input type="radio" class="view-input" name="plan-view" id="view-cards" value="cards" checked aria-controls="plan-options" />
                    <label class="view-option" for="view-cards">
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1" /><rect x="12" y="3" width="5" height="5" rx="1" /><rect x="3" y="12" width="5" height="5" rx="1" /><rect x="12" y="12" width="5" height="5" rx="1" /></svg>
                        @Text["Picker.ViewCards"]
                    </label>
                    <input type="radio" class="view-input" name="plan-view" id="view-comparison" value="comparison" aria-controls="plan-options" />
                    <label class="view-option" for="view-comparison">
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 4h14M3 10h14M3 16h14M8 3v14" /></svg>
                        @Text["Picker.ViewCompare"]
                    </label>
                </div>
            </fieldset>
        </div>

        <div class="comparison-head hts-label" aria-hidden="true">
            <span>@Text["Picker.ComparePlan"]</span>
            <span>@Text["Picker.Memory"]</span>
            <span>@Text["Picker.CompareResources"]</span>
            <span>@Text["Picker.ComparePrice"]</span>
        </div>

        <ul class="plans" id="plan-options" data-motion-stagger>
            @foreach (var (plan, index) in Plans.Select((p, i) => (p, i)))
            {
                <li class="plan @(plan.IsRecommended ? "is-recommended" : null)"
                    data-reveal
                    aria-labelledby="@($"plan-{Game.Slug}-{plan.Slug}")"
                    data-motion-step="card"
                    style="--hts-reveal-delay: @(index * 60)ms">

                    <header class="plan-head">
                        <div class="plan-title">
                            <h3 class="plan-name" id="@($"plan-{Game.Slug}-{plan.Slug}")">@plan.Name</h3>
                            @if (plan.IsRecommended)
                            {
                                <span class="plan-flag hts-label">@Text["Picker.Recommended"]</span>
                            }
                        </div>
                        <p class="plan-tagline">@plan.Tagline</p>
                    </header>

                    <div class="plan-memory">
                        <span class="memory-value hts-mono">@plan.MemoryGb</span>
                        <span class="memory-unit hts-label">@Text["Picker.Memory"]</span>
                    </div>

                    <dl class="plan-specs">
                        <div>
                            <dt>@Text["Picker.Cpu"]</dt>
                            <dd class="hts-mono">@Text["Picker.CpuValue", plan.CpuPercent]</dd>
                        </div>
                        <div>
                            <dt>@Text["Picker.Storage"]</dt>
                            <dd class="hts-mono">@Text["Picker.StorageValue", plan.DiskGb]</dd>
                        </div>
                        <div>
                            <dt>@Text["Picker.Backups"]</dt>
                            <dd class="hts-mono">@plan.BackupLimit</dd>
                        </div>
                        <div class="spec-bot @(plan.HasServerBot ? "is-included" : null)">
                            <dt>@Text["Picker.Bot"]</dt>
                            <dd>
                                @if (plan.HasServerBot)
                                {
                                    <span class="bot-lamp" aria-hidden="true"></span>
                                }
                                @(plan.HasServerBot ? Text["Picker.BotIncluded"] : Text["Picker.BotNotIncluded"])
                            </dd>
                        </div>
                    </dl>

                    @if (plan.IsPriced)
                    {
                        @foreach (var option in Catalog.BillingOptions)
                        {
                            var quote = Catalog.Quote(plan, option.Period)!;

                            <div class="plan-price" data-period="@option.Slug">
                                <p class="price-figure">
                                    <span class="price-symbol">@Currencies.Symbol(Currency)</span><span class="price-amount hts-mono">@Currencies.FormatCatalogNumber(quote.FinalAmount, Currency)</span>
                                    <span class="price-unit">@UnitFor(option)</span>
                                </p>

                                @if (quote.IsDiscounted)
                                {
                                    <p class="price-line hts-mono">
                                        <span class="price-was">@Currencies.FormatCatalogAmount(quote.BaseAmount, Currency)</span>
                                        <span class="price-equivalent">@Text["Picker.Equivalent", Currencies.FormatAmount(Currencies.ConvertAmount(quote.FinalAmount, Currency) / quote.Months, Currency)]</span>
                                    </p>
                                }
                                else
                                {
                                    <p class="price-line hts-mono">@Text["Picker.MonthlyNote"]</p>
                                }

                                <CtaButton Href="@SiteRoutes.Review(Game.Slug, plan.Slug, option.Period, Currency)"
                                           Variant="@(plan.IsRecommended ? CtaVariant.Primary : CtaVariant.Secondary)"
                                           TrailingIcon="IconName.ArrowRight"
                                           CssClass="plan-cta">
                                    @Text["Picker.Choose", plan.Name]
                                </CtaButton>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="plan-price is-pending">
                            <p class="price-pending hts-mono">@Text["Picker.Unpriced"]</p>
                        </div>
                    }
                </li>
            }
        </ul>

        <p class="picker-note">@Text["Picker.ReviewNote"]</p>
        @if (Currency == "brl")
        {
            <p class="picker-note">@Text["Currency.BrlNote", Currencies.FormatCatalogAmount(1m, "brl")]</p>
        }
    </div>
</section>

@code {
    [CascadingParameter(Name = "StorefrontCurrency")]
    public string Currency { get; set; } = "usd";

    /// <summary>The game the plans are sold for; its slug goes into every review link.</summary>
    [Parameter, EditorRequired]
    public HostedGame Game { get; set; } = default!;

    /// <summary>The plans to show, smallest first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<HostingPlan> Plans { get; set; } = [];

    /// <summary>The section number printed in the kicker.</summary>
    [Parameter]
    public string Index { get; set; } = "02";

    private HostingPlan? Smallest => Plans.Count == 0 ? null : Plans[0];

    private HostingPlan? Largest => Plans.Count == 0 ? null : Plans[^1];

    private string UnitFor(BillingOption option) => option.Period switch
    {
        BillingPeriod.Monthly => Text["Picker.PerMonth"],
        BillingPeriod.Quarterly => Text["Picker.PerQuarter"],
        _ => Text["Picker.PerYear"]
    };
}


# HowToSoftware Hosting
# Copy this file to .env and replace only the placeholders you need.
# Never commit .env. The application also accepts ASP.NET Core's Section__Key names.

# ============================================================
# STRIPE
# ============================================================

# Stripe Dashboard -> Developers -> API keys. Test keys are required during development.
STRIPE_PUBLISHABLE_KEY=pk_test_API_AQUI
# SERVER ONLY. Never expose this value to browser code.
STRIPE_SECRET_KEY=sk_test_API_AQUI
# `stripe listen` prints this local webhook signing secret.
STRIPE_WEBHOOK_SECRET=whsec_API_AQUI

# Stripe replaces {CHECKOUT_SESSION_ID}; the application replaces the public catalogue slugs.
STRIPE_SUCCESS_URL=https://SITE_AQUI/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://SITE_AQUI/payment/cancel?game={GAME_SLUG}&plan={PLAN_SLUG}&period={BILLING_PERIOD}&currency={CURRENCY}
STRIPE_CURRENCY=usd
# USD remains the base catalogue; Brazilian browser pricing converts once on the server.
# BRL is a real checkout currency, not a display-only approximation.
HostingPlans__RegionalPricing__BrlPerUsd=6.50
# Pix for subscriptions is a separate, OFF-by-default operational opt-in.
# HTS confirmed a US Stripe account and merchant-paid IOF. Verify capability in staging first.
Stripe__PixSubscriptions__Enabled=false
Stripe__PixSubscriptions__AccountCountry=US
# HTS absorbs IOF, keeping the advertised BRL total; do not add an IOF surcharge in the site.
Stripe__PixSubscriptions__AmountIncludesIof=always
# Activation, staging and migration checklist: docs/REGIONAL-PRICING.md.
# Optional. Signature timestamp tolerance in seconds (Stripe default: 300).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional pre-created Stripe Price IDs. Inline recurring prices are used when absent.
# ASP.NET Core nested keys keep the Section__Key syntax:
# Stripe__PriceIds__zomboid-8gb:monthly=price_API_AQUI
# Stripe__PriceIds__zomboid-8gb:quarterly=price_API_AQUI
# Stripe__PriceIds__zomboid-8gb:annual=price_API_AQUI
# Currency-qualified keys are required for BRL; legacy two-part keys are USD only.
# Stripe__PriceIds__zomboid-8gb:monthly:brl=price_BRL_API_AQUI
# Stripe__PriceIds__zomboid-8gb:quarterly:brl=price_BRL_API_AQUI
# Stripe__PriceIds__zomboid-8gb:annual:brl=price_BRL_API_AQUI

# Optional temporary rate-card overrides. Prices will ultimately move to the admin database;
# until then, use these only for a deliberate configuration override.
# HostingPlans__Rates__CpuPer100Percent=0.90
# HostingPlans__Rates__MemoryPerGb=1.20
# HostingPlans__Rates__DiskPerBlock=0.30
# HostingPlans__Prices__zomboid-8gb=14.99

# ============================================================
# SQL SERVER
# ============================================================

# SERVER ONLY. Commerce schema. Encryption is forced on by the application; add
# TrustServerCertificate=True only for a server whose certificate your host does not trust,
# and understand that doing so permits a machine-in-the-middle.
SQLSERVER_CONNECTION_STRING=Server=HOST,1433;Database=DB_AQUI;User Id=USER_AQUI;Password=SENHA_AQUI;Encrypt=True

# ============================================================
# PTERODACTYL
# ============================================================

PTERODACTYL_PANEL_URL=https://PANEL_AQUI
# SERVER ONLY. Admin -> Application API; must be an Application key with ptla_ prefix.
PTERODACTYL_APPLICATION_API_KEY=ptla_API_AQUI
# Real deployment tests never run unless deliberately enabled.
PTERODACTYL_DEPLOY_TESTS_ENABLED=false

# Project Zomboid topology. These are identifiers/configuration, not secrets.
PTERODACTYL_LOCATION_ID=0
PTERODACTYL_NEST_ID=0
PTERODACTYL_EGG_ID=0
# Leave these blank to use the egg defaults.
PTERODACTYL_DOCKER_IMAGE=
PTERODACTYL_STARTUP_COMMAND=
PTERODACTYL_TIMEOUT_SECONDS=30
# Collection/map values use the native ASP.NET Core Section__Key form:
# Pterodactyl__PortRange__0=16261-16281
# Pterodactyl__Environment__SERVER_NAME=HowToSoftware Server

# ============================================================
# APPLICATION
# ============================================================

APP_BASE_URL=https://SITE_AQUI
APP_ENVIRONMENT=Development
# Host-header allowlist. Include the public hostname and loopback for deployment health checks.
# Compose preserves this value; add your LAN IP explicitly only when testing on that address.
APP_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];host.howto.software;SITE_AQUI
# Optional: IP of each reverse proxy allowed to supply X-Forwarded-For/Proto. Never use '*'.
# Security__KnownProxies__0=127.0.0.1
# Security__KnownProxies__1=10.0.0.2

# Used only when SQLSERVER_CONNECTION_STRING is absent: the smaller orders-only schema.
ConnectionStrings__Hosting=Server=HOST,1433;Database=DB_AQUI;User Id=USER_AQUI;Password=SENHA_AQUI;Encrypt=True

# ============================================================
# AUTOMATIC GAME TRIALS (PROJECT ZOMBOID AND MINECRAFT)
# ============================================================

# Enable only on a host with the commerce migration, panel and SMTP configured.
Trials__Enabled=false

Trials__DurationHours=24
Trials__RetentionHours=72
# Pterodactyl limits are in MiB. CPU 0 means unlimited shared CPU.
Trials__MemoryMb=6144
Trials__CpuPercent=0
Trials__DiskMb=25600
Trials__BackupLimit=1
Trials__VerificationLifetimeMinutes=60
Trials__ReservationLifetimeMinutes=120
Trials__PollIntervalSeconds=30
Trials__RetryDelaySeconds=60
# Lease duration must exceed Pterodactyl__TimeoutSeconds by more than 30 seconds.
Trials__LeaseMinutes=5

# PZ uses the existing PTERODACTYL_* egg/location configuration above.
# Minecraft requires approved profiles. Repeat the indexed block for Java vanilla,
# Paper, Forge, Fabric or Bedrock, using each actual egg's version variable and ports.
# Trial users select profile/version; they never supply images, startup commands or eggs.
# Trials__Profiles__0__Id=java-paper
# Trials__Profiles__0__GameSlug=minecraft
# Trials__Profiles__0__Edition=java
# Trials__Profiles__0__Variant=Paper
# Trials__Profiles__0__Enabled=false
# Trials__Profiles__0__LocationId=0
# Trials__Profiles__0__NestId=0
# Trials__Profiles__0__EggId=0
# Trials__Profiles__0__VersionEnvironmentVariable=REPLACE_WITH_ACTUAL_EGG_VARIABLE
# Trials__Profiles__0__AllowedVersions__0=REPLACE_WITH_APPROVED_VERSION
# Trials__Profiles__0__PortRange__0=REPLACE_WITH_CONFIGURED_PORT_RANGE
# Trials__Profiles__0__Environment__REQUIRED_EGG_VARIABLE=REPLACE_WITH_VALUE
# For Bedrock use Edition=bedrock, Variant=Bedrock and its own approved egg/profile.

# SERVER ONLY. HTS sends verification, server-ready and expiration messages.
# The panel also needs its own SMTP to send password setup/reset messages.
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=HTS Hosting
Smtp__DeliveryTimeoutSeconds=15

# ============================================================
# CUSTOMER AREA / PAID PLAN CHANGES
# ============================================================
# Apply commerce migrations BEFORE enabling; see docs/CUSTOMER-AREA.md.
# Sign-in reuses SMTP above; no panel password or shared frontend secret.
CustomerArea__Enabled=false
# Development only: explicitly labelled empty UI preview; grants no account access.
CustomerArea__PreviewEnabled=false
# Keep OFF until Stripe test-mode + panel staging validation.
SubscriptionManagement__Enabled=false
SubscriptionManagement__ReconciliationEnabled=false
SubscriptionManagement__PollSeconds=60
SubscriptionManagement__QuoteMinutes=5

# ============================================================
# FUTURE EXTERNAL IDENTITIES (OFF BY DEFAULT)
# ============================================================
# Existing email sign-in stays unchanged. Do NOT enable Active Directory yet:
# Hank confirmed on-premises AD; the AD FS / LDAPS adapter choice is pending.
ExternalIdentity__ActiveDirectory__Enabled=false
ExternalIdentity__ActiveDirectory__LoginEnabled=false
ExternalIdentity__ActiveDirectory__Protocol=Unspecified
ExternalIdentity__ActiveDirectory__Issuer=
# Discord links an existing verified HTS account. Login is a separate opt-in.
# Apply the external-identity migration and configure the application before enabling.
ExternalIdentity__Discord__Enabled=false
ExternalIdentity__Discord__LoginEnabled=false
ExternalIdentity__Discord__ClientId=
# SERVER ONLY: inject through the secret store, never ship in browser code.
ExternalIdentity__Discord__ClientSecret=

# Minecraft paid tiers are separate commercial configuration, empty by default.
# Purchases convert an existing verified Minecraft trial; no world is reinstalled.
# Enter agreed resources/pricing and matching commerce catalog rows before offering a tier.
# MinecraftPlans__Tiers__0__Slug=minecraft-REPLACE_WITH_PLAN
# MinecraftPlans__Tiers__0__Name=REPLACE_WITH_PLAN_NAME
# MinecraftPlans__Tiers__0__Description=REPLACE_WITH_DESCRIPTION
# MinecraftPlans__Tiers__0__MemoryMb=REPLACE_WITH_MIB
# MinecraftPlans__Tiers__0__CpuPercent=REPLACE_WITH_CPU_PERCENT
# MinecraftPlans__Tiers__0__DiskMb=REPLACE_WITH_MIB
# MinecraftPlans__Tiers__0__MonthlyPrice=REPLACE_WITH_DECIMAL_PRICE
# MinecraftPlans__Tiers__0__BackupLimit=1
# MinecraftPlans__Tiers__0__AllocationLimit=1

# Public announcements advertise existing database coupons only (up to three).
# Leave unset to publish no code; private coupons are never enumerated automatically.
# PublicPromotions__Campaigns__0__Code=REPLACE_WITH_EXISTING_PUBLIC_CODE
# PublicPromotions__Campaigns__0__GameSlug=project-zomboid
# PublicPromotions__Campaigns__0__PlanSlug=zomboid-6gb
# PublicPromotions__Campaigns__0__Period=monthly
